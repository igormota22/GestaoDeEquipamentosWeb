@using GestaoDeEquipamentosWeb.ConsoleApp.Models
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Chamado";

    List<ListarEquipamentosViewModel> equipamentos = ViewBag.Equipamentos;

}



@model EditarChamadoViewModel;

<form class="formulario" action="/Chamado/Editar/@Model.Id" method="post">
    <div class="formulario-campo">
        <label>Titulo</label>
        <br>
        <input type="text" name="Titulo" value="@Model.Titulo">
    </div>

    <div class="formulario-campo">
        <label>Descrição</label>
        <br>
        <input type="text" name="Descricao" value="@Model.Descricao">
    </div>

    <div class="formulario-campo">
        <label>Equipamento</label>
        <select name="EquipamentoId">
            @foreach (ListarEquipamentosViewModel e in equipamentos)
            {
                <option value="@e.Id">@e.Nome</option>
            }
        </select>
    </div>

    <div class="formulario-acoes">
        <a href="/Chamado/Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>

</form>