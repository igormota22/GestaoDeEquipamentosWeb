@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Chamado";

    List<SelectListItem> equipamentos = ViewBag.Equipamentos;

}



@model EditarChamadoViewModel;

<form class="formulario" asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div class="formulario-campo">
        <label asp-for="Titulo">Titulo</label>
        <br>
        <input asp-for="Titulo" type="text" value="@Model.Titulo">
        <span asp-validation-for="Titulo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="Descricao">Descrição</label>
        <br>
        <textarea asp-for="Descricao" type="text" value="@Model.Descricao"></textarea>
        <span asp-validation-for="Descricao"></span>

    </div>

    <div class="formulario-campo">
        <label asp-for="EquipamentoId">Equipamento</label>
        <select asp-for="EquipamentoId" asp-items="equipamentos">
            <option value="EquipamentoId">Selecione um equipamento</option>

        </select>
        <span asp-validation-for="EquipamentoId"></span>
    </div>

    <div></div>

    <div class="formulario-acoes">
        <a asp-action="Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>

</form>