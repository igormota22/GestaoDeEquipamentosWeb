@using GestaoDeEquipamentosWeb.ConsoleApp.Models

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de equipamento";

}

@model List<ListarEquipamentosViewModel>;





<a class="btn-cadastrar" href="/Equipamento/Cadastrar">Cadastrar novo</a>

<table class="registros">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Preço de Aquisição</th>
            <th>Data de Fabricação</th>
            <th>Fabricante</th>
            <th>Ação 1</th>
            <th>Ação 2</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ListarEquipamentosViewModel e in Model)
        {
            <tr>
                <td>@e.Id</td>
                <td>@e.Nome</td>
                <td>@e.PrecoAquisicao.ToString(format: "C2")</td>
                <td>@e.DataFabricacao.ToShortDateString()</td>
                <td>@e.Fabricante</td>
                <td><a href="/Equipamento/Editar/@e.Id">Editar</a>
                </td>
                <td><a href="/Equipamento/Excluir/@e.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<br>


