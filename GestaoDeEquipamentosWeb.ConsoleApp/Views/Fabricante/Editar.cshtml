﻿@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de fabricante";

}

@using GestaoDeEquipamentosWeb.ConsoleApp.ModuloFabricante

@model Fabricante;



<form action="/Fabricante/Editar/@Model.Id" method="post">
    <div>
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome">
    </div>

    <div>
        <label>Email</label>
        <br>
        <input type="email" name="Email" value="@Model.Email">
    </div>

    <div>
        <label>Telefone</label>
        <br>
        <input type="text" name="Telefone" value="@Model.Telefone">
    </div>

    <hr>

    <a href="/Fabricante/listar">Voltar</a>
    <button type="submit">Confirmar</button>
</form>