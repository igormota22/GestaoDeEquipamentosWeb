﻿@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de fabricante";

}

@using GestaoDeEquipamentosWeb.ConsoleApp.Models

@model ExcluirFabricanteViewModel;

<form class="formulario" action="/Fabricante/Excluir/@Model.Id" method="post">

    <p class="formulario-alerta">Deseja mesmo excluir este fabricante?</p>

    <div class="formulario-campo">
        <label>Nome</label>
        <br>
        <input type="text" name="Nome" value="@Model.Nome" disabled>
    </div>

    <div class="formulario-campo">
        <label>Email</label>
        <br>
        <input type="email" name="Email" value="@Model.Email" disabled>
    </div>

    <div class="formulario-campo">
        <label>Telefone</label>
        <br>
        <input type="text" name="Telefone" value="@Model.Telefone" disabled>
    </div>

    <div class="formulario-acoes">
        <a href="/Fabricante/Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>

   
</form>