@using GestaoDeEquipamentosWeb.ConsoleApp.Models

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de fabricante";

}

@model List<ListarFabricantesViewModel>;

<a class="btn-cadastrar" asp-action="Cadastrar">Cadastrar novo</a>

<table class="registros">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Ação 1</th>
            <th>Ação 2</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ListarFabricantesViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td><a asp-action="Editar" asp-route-id="@f.Id">Editar</a></td>
                <td><a asp-action="Excluir" asp-route-id="@f.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<br>


