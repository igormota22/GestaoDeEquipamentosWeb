@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de fabricante";

}
@using GestaoDeEquipamentosWeb.ConsoleApp.ModuloFabricante
@model List<Fabricante>;




<hr>
<a href="/Fabricante/Cadastrar">Cadastrar novo</a>
<hr>
<table border="1" cellpadding="10">
    <thead>
        <tr>
            <td>Id</td>
            <td>Nome</td>
            <td>Email</td>
            <td>Telefone</td>
            <td>Ação 1</td>
            <td>Ação 2</td>
        </tr>
    </thead>
    <tbody>
        @foreach (Fabricante f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td> <a href="Fabricante/Editar">Editar</a>
                </td>
                <td> <a href="Fabricante/Excluir">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<br>
<a href="/Home/Index">Voltar</a>


