<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Titulo - Gestao de Equipamentos</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
    rel="stylesheet">

    <link rel="stylesheet" href="~/CSS/styles.CSS">
</head>

<body>
    <nav>
        <h3>Gestão de Equipamentos</h3>

        <div class="Links-navbar">
            <a asp-controller="Fabricante" asp-action="listar">Controle de Fabricantes</a>
            <a asp-controller="Equipamento" asp-action="listar">Controle de Equipamentos</a>
            <a asp-controller="Chamado" asp-action="listar">Controle de Chamados</a>
            <a href="/Home/Index">Inicio</a>
        </div>
    </nav>

    <header>
        <h2 class="titulo-pagina">@ViewBag.Titulo</h2>
    </header>

    <main>
        @RenderBody()
    </main>

</body>

</html>
